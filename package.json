{
  "name": "@arkhe-cathedral/arkhe-js",
  "version": "1.0.0",
  "description": "ARKHE.JS — Kernel JavaScript/TypeScript da Catedral ARKHE. Módulo de coerência geométrica para ecossistema Arkhe-OS.",
  "main": "dist/arkhe.js",
  "module": "dist/arkhe.mjs",
  "types": "dist/arkhe.d.ts",
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .js,.ts",
    "lint:fix": "eslint src/ --ext .js,.ts --fix",
    "format": "prettier --write src/",
    "docs": "typedoc --out docs/ src/arkhe.ts",
    "prepublishOnly": "npm run build && npm run build:types && npm test",
    "start:websocket": "node dist/websocket-server.js",
    "benchmark": "node benchmarks/kuramoto-benchmark.js"
  },
  "keywords": [
    "arkhe",
    "cathedral",
    "coherence",
